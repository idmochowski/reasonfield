# =============================================================================
# REASONFIELD ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# Google Cloud Configuration
GCS_BUCKET=reasonfield-uploads
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI/ML Configuration
GEMINI_API=your-gemini-api-key

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,https://app.reasonfield.com

# Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET=your-jwt-secret-here-change-in-production

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Bias Analysis Configuration
BIAS_DEFINITIONS_DIRECTORY=papers
BIAS_DEFINITIONS_FILENAME=bias-definitions.json

# Monitoring Configuration (Optional)
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=your-ga-id

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# API Configuration
VITE_API_BASE_URL=https://api.reasonfield.com

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Google Cloud Project
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# Allowed Users (comma-separated emails)
ALLOWED_EMAILS=your-email@gmail.com,another-email@gmail.com

# =============================================================================
# CLOUDFLARE CONFIGURATION (for deployment scripts)
# =============================================================================
# Note: These are also in cloudflare.env for deployment scripts

# CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id 